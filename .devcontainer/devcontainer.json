{
  "name": "Elite Battleground - Godot Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5900],
  "portsAttributes": {
    "5900": {
      "label": "VNC Desktop",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ]
    }
  },
  "remoteUser": "vscode"
}
