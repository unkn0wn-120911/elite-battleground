{
  "name": "Elite Battleground - Godot Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080, 5900],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Browser",
      "onAutoForward": "openBrowser"
    },
    "5900": {
      "label": "VNC Desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ]
    }
  },
  "postStartCommand": "bash ${containerWorkspaceFolder}/start-vnc.sh",
  "postAttachCommand": "bash ${containerWorkspaceFolder}/start-vnc.sh",
  "remoteUser": "vscode"
}
