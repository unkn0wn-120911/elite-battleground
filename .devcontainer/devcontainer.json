{
  "name": "Elite Battleground - Godot Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5900, 6080],
  "portsAttributes": {
    "5900": {
      "label": "VNC Desktop",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "noVNC Browser (fallback)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ]
    }
  },
  "postStartCommand": "bash ${containerWorkspaceFolder}/start-vnc.sh",
  "postAttachCommand": "bash ${containerWorkspaceFolder}/start-vnc.sh",
  "remoteUser": "vscode"
}
