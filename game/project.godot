[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Enemy"
3d_physics/layer_3="Ground"
3d_physics/layer_4="Weapon"
3d_physics/layer_5="Pickup"
3d_physics/layer_6="Projectile"
3d_physics/layer_7="Vehicle"
3d_physics/layer_8="Building"
3d_physics/layer_9="Trigger"
3d_physics/layer_10="UI"

[network]

limits/threads/thread_pool_size=16

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.5
3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)
3d/default_linear_damp=0.1
3d/default_angular_damp=0.1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/cache_gpu_compressor=false
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.1, 1)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=0
environment/ssil/quality=0
lights_and_shadows/transparent_shadows=true
debugger/max_node_selection=25

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"
driver/enable_audio=true
driver/mix_rate=44100
driver/channel_count=2

[gui]

theme/custom_font_size=16
theme/default_font_antialiased=true
theme/default_font_generate_mipmaps=true
theme/default_font_multichannel_signed_distance_field=false

[internationalization]

locale/fallback="en"
locale/test="en"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics_2d]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.1, 1)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/transparent_shadows=true

[autoload]

SaveManager="*res://scripts/save_manager.gd"
PlayerManager="*res://autoload/player_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameManager="*res://autoload/game_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
