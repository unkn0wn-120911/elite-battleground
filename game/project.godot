; Engine configuration file.
; Elite Battleground - Project Settings
; Version: 0.1.0
; Engine: Godot 4.2+
; Rendering: GL Compatibility (for cloud/Codespaces support)

config_version=5

[application]

config/name="Elite Battleground"
config/description="A modern 3D battle royale action game - Prove You Are Elite"
config/version="0.1.0"
run/main_scene="res://scenes/loading_screen.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"
config/use_hidden_project_data_directory=true
config/use_custom_user_dir=false
config/custom_user_dir_name=""
config/project_settings_override=""

[autoload]

SaveManager="*res://scripts/save_manager.gd"
PlayerManager="*res://autoload/player_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameManager="*res://autoload/game_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"

[debug]

gdscript/warnings/enable=true
gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/size/borderless=false
window/size/always_on_top=false
window/size/transparent=false
window/size/expand_to_title=true
window/size/auto_resize=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1
window/vsync/allow_hidpi=true

